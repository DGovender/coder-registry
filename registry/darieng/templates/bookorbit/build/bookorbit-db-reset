#!/usr/bin/env bash
set -euo pipefail

workspace_dir="${BOOKORBIT_WORKSPACE_DIR:-$HOME/bookorbit}"
expected_database_url="postgres://bookorbit:bookorbit@postgres:5432/bookorbit"

if [[ "${BOOKORBIT_RESET_CONFIRM:-}" != "yes" ]]; then
  echo "This deletes the BookOrbit Coder development database and generated local data."
  echo "Run: BOOKORBIT_RESET_CONFIRM=yes bookorbit-db-reset"
  exit 2
fi

cd "$workspace_dir"
database_url="$(sed -n 's/^DATABASE_URL=//p' server/.env | head -n 1)"

if [[ "$database_url" != "$expected_database_url" ]]; then
  echo "Refusing to reset a database other than this workspace's private Coder database." >&2
  exit 1
fi

echo "Resetting the private Coder development database..."
psql "$database_url" -v ON_ERROR_STOP=1 -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'
psql "$database_url" -v ON_ERROR_STOP=1 -c 'CREATE SCHEMA IF NOT EXISTS drizzle;'
psql "$database_url" -v ON_ERROR_STOP=1 -c 'CREATE TABLE IF NOT EXISTS drizzle.__drizzle_migrations (id serial PRIMARY KEY, hash text NOT NULL, created_at bigint);'

echo "Applying migrations and baseline data..."
pnpm db:migrate
pnpm db:seed

echo "Cleaning generated local data..."
rm -rf local/data/covers local/data/book-bucket/covers local/data/authors local/data/book-bucket/authors
mkdir -p local/data/covers local/data/book-bucket/covers local/data/authors local/data/book-bucket/authors

echo "BookOrbit Coder development reset complete."
